{
  "test_set_version": "1.0",
  "notes": "50 Egyptian-Arabic cases per 02-poc/TEST_PLAN.md §2. Seeded entities (deterministic fake or demo Odoo): partners 42='محمد أحمد', 43='شركة النيل للتجارة', 44='محمد سيد', 45='أحمد حسن', 46='مؤسسة النيل', 47='شركة الأمل'; products 55='مياه معدنية 1.5 لتر', 56='زيت عباد الشمس 1 لتر', 57='أرز أبو بنت', 58='سكر 1 كيلو', 59='شاي العروسة 250 جم'; order 100 (draft, partner 42).",
  "test_cases": [
    { "id": "TC-001", "category": "read_happy", "user": "sales_user@test", "input": "هاتلي العميل محمد أحمد", "expected_tool": "customer.search", "expected_args": { "query": "محمد أحمد" }, "expected_outcome": "success" },
    { "id": "TC-002", "category": "read_happy", "user": "sales_user@test", "input": "دوّرلي على شركة النيل للتجارة", "expected_tool": "customer.search", "expected_args": { "query": "شركة النيل للتجارة" }, "expected_outcome": "success" },
    { "id": "TC-003", "category": "read_happy", "user": "sales_user@test", "input": "مين اللي اسمه أحمد عندنا؟", "expected_tool": "customer.search", "expected_args": { "query": "أحمد" }, "expected_outcome": "success", "notes": "Partial-name: multiple matches expected (42, 45) - return list" },
    { "id": "TC-004", "category": "read_happy", "user": "sales_user@test", "input": "جيبلي بيانات العميل رقم 42", "expected_tool": "customer.get", "expected_args": { "customer_id": 42 }, "expected_outcome": "success" },
    { "id": "TC-005", "category": "read_happy", "user": "sales_user@test", "input": "عايز أعرف بيانات العميل 47", "expected_tool": "customer.get", "expected_args": { "customer_id": 47 }, "expected_outcome": "success" },
    { "id": "TC-006", "category": "read_happy", "user": "sales_user@test", "input": "اعرضلي الأوردر رقم 100", "expected_tool": "sales.order.get", "expected_args": { "order_id": 100 }, "expected_outcome": "success" },
    { "id": "TC-007", "category": "read_happy", "user": "sales_user@test", "input": "قولي حالة الطلب 100", "expected_tool": "sales.order.get", "expected_args": { "order_id": 100 }, "expected_outcome": "success" },
    { "id": "TC-008", "category": "read_happy", "user": "sales_user@test", "input": "في عميل اسمه محمد؟", "expected_tool": "customer.search", "expected_args": { "query": "محمد" }, "expected_outcome": "success", "notes": "Ambiguous partial name, 2 matches: list them" },
    { "id": "TC-009", "category": "read_happy", "user": "sales_user@test", "input": "ابحث عن عميل اسمه كريم", "expected_tool": "customer.search", "expected_args": { "query": "كريم" }, "expected_outcome": "not_found", "notes": "Nonexistent entity: zero hits is a valid answer, no invented ID" },
    { "id": "TC-010", "category": "read_happy", "user": "sales_user@test", "input": "اعرضلي العملاء اللي في اساميهم مؤسسة", "expected_tool": "customer.search", "expected_args": { "query": "مؤسسة" }, "expected_outcome": "success" },
    { "id": "TC-011", "category": "read_happy", "user": "sales_user@test", "input": "هاتلي رقم تليفون العميل أحمد حسن", "expected_tool": "customer.search", "expected_args": { "query": "أحمد حسن" }, "expected_outcome": "success" },
    { "id": "TC-012", "category": "read_happy", "user": "sales_user@test", "input": "العميل رقم 44 مين؟", "expected_tool": "customer.get", "expected_args": { "customer_id": 44 }, "expected_outcome": "success" },
    { "id": "TC-013", "category": "read_happy", "user": "sales_user@test", "input": "ابعتلي بيانات شركة الأمل", "expected_tool": "customer.search", "expected_args": { "query": "شركة الأمل" }, "expected_outcome": "success" },
    { "id": "TC-014", "category": "read_happy", "user": "sales_user@test", "input": "عايز أشوف تفاصيل العميل 43 كاملة", "expected_tool": "customer.get", "expected_args": { "customer_id": 43 }, "expected_outcome": "success" },
    { "id": "TC-015", "category": "read_happy", "user": "sales_user@test", "input": "دوّر على عميل اسمه النيل", "expected_tool": "customer.search", "expected_args": { "query": "النيل" }, "expected_outcome": "success", "notes": "2 matches (43, 46): list for disambiguation" },
