# Agent-Native ERP POC — environment template (placeholders ONLY — no real credentials)
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Variable set per 02-poc/TECHNICAL_DESIGN.md §13.

# Odoo (read ONLY by the gateway/adapter module)
ODOO_URL=http://localhost:8069
ODOO_DATABASE=poc_test
ODOO_API_KEY_SALES_USER=REPLACE_WITH_KEY_GENERATED_IN_ODOO_UI
ODOO_API_KEY_READONLY_USER=REPLACE_WITH_KEY_GENERATED_IN_ODOO_UI
ODOO_API_KEY_NO_ACCESS_USER=REPLACE_WITH_KEY_GENERATED_IN_ODOO_UI

# LLM (read ONLY by the agent module) — provider chosen by LLM_PROVIDER
#   anthropic           (default) official Anthropic SDK.
#                         Optional ANTHROPIC_BASE_URL targets Anthropic-
#                         compatible providers, e.g. z.ai GLM:
#                         https://api.z.ai/api/anthropic  (key: z.ai API key)
#   openai_compatible   any OpenAI-schema endpoint (OpenAI, NVIDIA NIM,
#                         OpenRouter, Together, DeepInfra, vLLM, Ollama...)
#                         configured via LLM_BASE_URL + LLM_API_KEY.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_KEY
# ANTHROPIC_BASE_URL=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# Model id read by poc/llm_client.py (used by both providers)
POC_LLM_MODEL=claude-sonnet-4-5-20250929
# Optional opt-in: force the model to always call a tool. Default OFF
# (unset/empty) so the model can still answer general chat in prose. Values
# "any" or "required", applied only when at least one tool is passed:
#   anthropic         "any" -> {"type": "any"}; "required" with exactly one
#                     tool -> {"type": "tool", "name": <tool>}, else
#                     {"type": "any"}
#   openai_compatible both -> "required"; "required" with exactly one tool ->
#                     {"type": "function", "function": {"name": <tool>}},
#                     else "required"
# FORCE_TOOL_CHOICE=

# Identity the CLI runs as (required by poc/bootstrap.py build_runtime)
POC_USER_ID=sales_user@test
TENANT_ID=poc_tenant_001

# Gateway store (read ONLY by the gateway/db module) — SQLite file path
GATEWAY_DB_PATH=data/poc_gateway.db
