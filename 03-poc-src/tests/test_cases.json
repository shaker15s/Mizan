    { "id": "TC-017", "category": "read_product", "user": "sales_user@test", "input": "كم سعر الزيت؟", "expected_tool": "product.search", "expected_args": { "query": "زيت" }, "expected_outcome": "success" },
    { "id": "TC-018", "category": "read_product", "user": "sales_user@test", "input": "هاتلي المنتج أرز", "expected_tool": "product.search", "expected_args": { "query": "أرز" }, "expected_outcome": "success" },
    { "id": "TC-019", "category": "read_product", "user": "sales_user@test", "input": "في سكر عندنا؟ بكام؟", "expected_tool": "product.search", "expected_args": { "query": "سكر" }, "expected_outcome": "success" },
    { "id": "TC-020", "category": "read_product", "user": "sales_user@test", "input": "دوّر على شاي", "expected_tool": "product.search", "expected_args": { "query": "شاي" }, "expected_outcome": "success" },
    { "id": "TC-021", "category": "write_happy", "user": "sales_user@test", "input": "اعمل طلب بيع للعميل 42 لعدد 20 من المنتج 55", "expected_tool": "sales.order.create", "expected_args": { "customer_id": 42, "lines": [ { "product_id": 55, "quantity": 20 } ] }, "expected_outcome": "success", "auto_confirm": true },
    { "id": "TC-022", "category": "write_happy", "user": "sales_user@test", "input": "سجّل أوردر بيع للعميل 43، منتج 56، الكمية 5", "expected_tool": "sales.order.create", "expected_args": { "customer_id": 43, "lines": [ { "product_id": 56, "quantity": 5 } ] }, "expected_outcome": "success", "auto_confirm": true },
    { "id": "TC-023", "category": "write_happy", "user": "sales_user@test", "input": "اعمل أوردر: العميل 44 ياخد 2 من المنتج 57", "expected_tool": "sales.order.create", "expected_args": { "customer_id": 44, "lines": [ { "product_id": 57, "quantity": 2 } ] }, "expected_outcome": "success", "auto_confirm": true },
    { "id": "TC-024", "category": "write_happy", "user": "sales_user@test", "input": "هات أوردر بيع للعميل 45 بـ10 قطعة من المنتج 55", "expected_tool": "sales.order.create", "expected_args": { "customer_id": 45, "lines": [ { "product_id": 55, "quantity": 10 } ] }, "expected_outcome": "success", "auto_confirm": true },
    { "id": "TC-025", "category": "write_happy", "user": "sales_user@test", "input": "العميل 47 عايز 3 كيلو سكر - اعمل الطلب (منتج 58)", "expected_tool": "sales.order.create", "expected_args": { "customer_id": 47, "lines": [ { "product_id": 58, "quantity": 3 } ] }, "expected_outcome": "success", "auto_confirm": true },
